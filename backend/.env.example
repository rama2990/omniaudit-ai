# Salin menjadi backend/.env lalu isi. File .env tidak ikut di-commit.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model Gemini (alias "latest" otomatis mengikuti versi terbaru)
GEMINI_MODEL=gemini-flash-latest
# auto = pakai Gemini bila ada key, selain itu pola teks lokal. Pilihan: auto | gemini | fake
GEMINI_MODE=auto

# Pindah ke Vertex AI (data tetap di region Jakarta): kosongkan GEMINI_API_KEY lalu isi
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=nama-project-gcp
# GOOGLE_CLOUD_LOCATION=asia-southeast2

# Jeda antar langkah Telemetry (detik) supaya alur agen terlihat saat demo
OMNI_TELEMETRY_DELAY=0.35
