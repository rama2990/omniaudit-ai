# Salin menjadi backend/.env lalu isi. File .env tidak ikut di-commit.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model Gemini (alias "latest" otomatis mengikuti versi terbaru)
GEMINI_MODEL=gemini-flash-latest
# auto = pakai Gemini bila ada key, selain itu pola teks lokal. Pilihan: auto | gemini | fake
GEMINI_MODE=auto

# Pakai Vertex AI dengan API key Vertex (Agent Platform > Settings > API Keys): isi GEMINI_API_KEY
# dengan key itu, GEMINI_MODEL=gemini-2.5-flash, lalu aktifkan baris ini. Jangan isi project/location bersamanya.
# GOOGLE_GENAI_USE_VERTEXAI=true

# Jeda antar langkah Telemetry (detik) supaya alur agen terlihat saat demo
OMNI_TELEMETRY_DELAY=0.35
